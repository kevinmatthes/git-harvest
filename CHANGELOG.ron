        "Added": [
          (text: "`git-harvest assemble` folds the fragments into a new CHANGELOG section", commit: None),
          (text: "`git-harvest init` writes a starter CHANGELOG carrying the default configuration", commit: None),
          (text: "`git-harvest render` exports the CHANGELOG as Keep a Changelog Markdown", commit: None),
          (text: "`git-harvest scan` harvests a branch\'s structured commit subjects into a RON fragment", commit: None),
