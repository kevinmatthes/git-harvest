{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": [
    "kevinmatthes"
  ],
  "automerge": false,
  "automergeStrategy": "squash",
  "commitMessageLowerCase": "never",
  "commitMessagePrefix": "[Renovate]",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "actionlint",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "rhysd/actionlint@(?<currentDigest>sha256:[0-9a-f]+) # (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "packageNameTemplate": "rhysd/actionlint"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "cffconvert",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "citationcff/cffconvert@(?<currentDigest>sha256:[0-9a-f]+) # (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "packageNameTemplate": "citationcff/cffconvert"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rust",
      "managerFilePatterns": [
        "/^\\.clippy\\.toml$/",
        "/^Cargo\\.toml$/"
      ],
      "matchStrings": [
        "msrv = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "rust-version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "packageNameTemplate": "rust-lang/rust"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "crate",
      "depNameTemplate": "cargo-semver-checks",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "cargo-semver-checks@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "packageNameTemplate": "cargo-semver-checks"
    }
  ],
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "dependencyDashboardLabels": [
    "dependencies"
  ],
  "dependencyDashboardTitle": "[Renovate] Dependency Dashboard",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true
  },
  "packageRules": [
    {
      "addLabels": [
        "github_actions"
      ],
      "matchDepNames": [
        "actionlint",
        "cffconvert"
      ],
      "matchManagers": [
        "custom.regex"
      ]
    },
    {
      "addLabels": [
        "rust"
      ],
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "addLabels": [
        "github_actions"
      ],
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "addLabels": [
        "documentation"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchManagers": [
        "custom.regex"
      ]
    },
    {
      "addLabels": [
        "rust"
      ],
      "matchDepNames": [
        "cargo-semver-checks"
      ],
      "matchManagers": [
        "custom.regex"
      ]
    },
    {
      "enabled": false,
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "automerge": true,
      "matchUpdateTypes": [
        "digest",
        "patch",
        "pin"
      ]
    }
  ],
  "platformAutomerge": true,
  "prHourlyLimit": 0
}
